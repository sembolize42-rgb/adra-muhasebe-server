# Bu dosyayı .env olarak kopyala ve gerçek değerleri gir. .env asla paylaşılmamalı/commit edilmemeli.

# Neon/Supabase/Railway'den alacağın Postgres bağlantı adresi (sslmode genelde otomatik).
DATABASE_URL=postgres://user:password@host:5432/dbname

# express-session cookie'lerini imzalamak için rastgele, uzun bir metin (scripts/gen-secret.js ile üretilebilir).
SESSION_SECRET=

# Ortak giriş şifresinin bcrypt hash'i (düz metin şifreyi buraya YAZMA).
# Üretmek için: npm run hash-password -- "seçtiğin-şifre"
APP_PASSWORD_HASH=

PORT=3000
